    {
      "id": "potential-priority",
      "title": {
        "en": "Potential Priority"
      },
      "blocks": [
        {
          "type": "prose",
          "body": {
            "en": "Ego Manifestation"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "E1:\nAdding Retain is really good\nE2:\nMoving Vulture to the top is really good\nE3:\nGains one Silver Veil on use, it's ok\nE4:\n+20% on Khalipe is butt\nE5:\nPotential Levels: It's ok\nE6:\n+100% to every Silver Veil proc"
          }
        }
      ]
    },
    {
      "id": "notable-refinements",
      "title": {
        "en": "Notable Refinements:"
      },
      "blocks": [
        {
          "type": "prose",
          "body": {
            "en": "When a 3-Cost or higher card is activated, 1 AP (1 time per turn)"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Increase Damage Amount of 2-Cost or higher Attack Cards by 25%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Increase Damage Amount of Attack Cards by 20%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "At the start of battle, if owning 18 or less cards, increase Damage Amount of Attack Cards by 30%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Increase Def Based Damage Amount by +30%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "If Damage is completely blocked, at the start of the next turn, increase Damage Amount of allies by 10% for 1 turn (1 time per turn)"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Increase Shield Gain Amount by 15%, and increase Heal Amount by 15%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "On Counterattack, 200% Def Based Damage to all enemies (1 time per turn)"
          }
        }
      ]
    },
