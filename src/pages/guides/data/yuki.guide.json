    {
      "id": "part-1",
      "title": {
        "en": "Part 1"
      },
      "blocks": [
        {
          "type": "card-list",
          "items": [
            {
              "cardId": "c_1057_srt4",
              "name": "Prepare to Subdue",
              "note": {
                "en": ""
              }
            }
          ]
        },
        {
          "type": "prose",
          "body": {
            "en": "Yuki's Inpsiration and Flash Slash Neutral Epiphanies"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Yuki's Gimmick is all about the \"Inspiration\" Keyword\nInspiration is Activated whenever the card is Drawn through an Ability\nCard effect, Ego Skill Card Effect, Equipment Effects are all considered Abilities\nTurn draw does not count for Inspiration\nFlash Slash Epiphanies\nBecause Flash Slash at a base is a 2 cost attack before Inpsiration\nIt is able to pick up extra strong Neutral epiphanies like +3 Moral or +2 Vuln"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "ONE DAY YUKI WILL BE GOOD SURELY\nInspiration on Neutrals WHEN\n(That Yuki can actually use)"
          }
        }
      ]
    },
