  "sections": [
    {
      "id": "veronica-s-ballistas-and-reload",
      "title": {
        "en": "Veronica's Ballistas and Reload"
      },
      "blocks": [
        {
          "type": "card-list",
          "items": [
            {
              "cardId": "c_1033_srt4",
              "name": "Firing Preparation",
              "note": {
                "en": ""
              }
            },
            {
              "cardId": "c_1033_uni2",
              "name": "Pendant of Resolution",
              "note": {
                "en": ""
              }
            }
          ]
        },
        {
          "type": "prose",
          "body": {
            "en": "Veronica's Main Gimmick is her Ballistas and Reload Stacks\nBallistas are Unique created cards with 0 cost, that Activate when turn is ended\nActivating a Ballista makes an \"Extra Attack\" and Exhausts it\nBallista's \"Extra Attacks\" Can Crit\nBallista's \"Extra Attacks\" Can be affected by Elemental Weakness Now\nReload is how Veronica increases the damage of Ballistas\nEvery stack of Reload is 50% Multiplicative damage for Ballistas that turn\nMax Reload Stacks is 3 base, 4 with Bombarment Prep and 5 with E4\nExample:\n150% Ballista with 2 Reload = 150% x 200% = 300% not 150% + 100% = 250%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Precision Aim and Eternal Hunger"
          }
        },
        {
          "type": "card-list",
          "items": [
            {
              "cardId": "n_0103",
              "name": "Precision Aim",
              "note": {
                "en": ""
              }
            }
          ]
        },
        {
          "type": "prose",
          "body": {
            "en": "Eternal Hunger has Attunement Draw 1, AP 1\nAttunement Activates when the Card is Drawn\nPrecision Aim can Draw Eternal Hungers, and Placing it on Top of theDeck\nPrecision Aim + Eternal Hunger means Positive Draw and AP"
          }
        }
      ]
    },
