    {
      "id": "rossweisse-s-self-buffs",
      "title": {
        "en": "Rossweisse's Self Buffs"
      },
      "blocks": [
        {
          "type": "deck",
          "cards": [
            {
              "cardId": "c_30134_srt4",
              "name": "Flicker Blade",
              "cost": 0,
              "epiphany": {
                "level": 1,
                "name": "Flicker Blade (Amped)",
                "text": {
                  "en": "[Equilux] [Unique] 600% Damage. On polarization, split into Shard:Light (Amped) and Shard:Dark (Amped)."
                }
              }
            },
            {
              "cardId": "c_30134_srt4_mut1",
              "name": "Shard:Light",
              "cost": 2
            },
            {
              "cardId": "c_30134_srt4_mut2",
              "name": "Shard:Dark",
              "cost": 2
            },
            {
              "cardId": "c_30134_cre1",
              "name": "Sword Tassel",
              "cost": 0
            },
            {
              "cardId": "c_30134_uni3",
              "name": "Blade of the Cycle",
              "cost": 1,
              "epiphany": {
                "level": 4,
                "name": "Blade of the Cycle IV",
                "text": {
                  "en": "300% Damage. 1 Brand of the Cycle for each Justice Card in hand. Purity: Decrease Cost by 1."
                }
              }
            }
          ]
        },
        {
          "type": "prose",
          "body": {
            "en": "Rossweisse(RW) Equilux, Apostle, Sword Tassel, Brand, Purity"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Equilux:\nStart of turn moves to hand, if moved split into Light and Dark\nLight and Dark variants depend on Flicker Blade version\nHit Count is fixed to 1\nSword Tassel:\nUnique Skill that RW stacks, combines into Flicker blade with Light and Dark\nFor each stack (Max 20) +80% Base Dmg max 1600% which is kinda crazy\nKyrken's Aegis:\nPermanent dmg buff to RW\nBrand of the Cycle:\nEnemy debuff that increases RW Card damage to enemy, decreases per card\nPurity:\nTriggered effect by having only 1 element of card in hand aka Justice"
          }
        },
        {
          "type": "deck",
          "cards": [
            {
              "cardId": "c_30134_uni4",
              "name": "Kyrken's Apostle",
              "cost": 0
            }
          ]
        },
        {
          "type": "prose",
          "body": {
            "en": "20% Multi (30% E1) + 75% Multi (Flow) + 20% Brand = 115% + E4 (40%) 155%\nFinal Damage Buff:\n15% (20% E1) to flicker blade + 20% = 35% to Flicker Blade\nE2 20% Final Damage straight up E6 + 30% = 50%"
          }
        }
      ]
    },
