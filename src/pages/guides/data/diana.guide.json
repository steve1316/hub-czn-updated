    {
      "id": "potential-priority",
      "title": {
        "en": "Potential Priority:"
      },
      "blocks": [
        {
          "type": "prose",
          "body": {
            "en": "Ego Manifestation:"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "E1:\nThis bad is butt, but technically makes it as a Build around more interesting\nE2:\nBig Extra Attack, requires discarding 10 Cards to do 400% Damage\nE3:\nThis is a pretty worthless Ego anyway\nE4:\nOnly adds Additive damage to Diana's Extra Attacks, +30%-50%, its okay\nE5:\nLow base Multipliers = Not much Value\nE6:\nMax 30 Fluters, but now that only requires 8 Discards, also bonus Extra Attack at 30"
          }
        }
      ]
    },
