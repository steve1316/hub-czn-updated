    {
      "id": "important-kayron-glossary-mechanics",
      "title": {
        "en": "Important Kayron Glossary/Mechanics"
      },
      "blocks": [
        {
          "type": "card-list",
          "items": [
            {
              "cardId": "c_1064_srt4",
              "note": {
                "en": ""
              }
            },
            {
              "cardId": "c_1064_cre1",
