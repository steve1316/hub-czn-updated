    {
      "id": "wilhelmina-erica-rachel-raidel",
      "title": {
        "en": "Wilhelmina | Erica | Rachel | Raidel"
      },
      "blocks": [
        {
          "type": "prose",
          "body": {
            "en": "Wilhelmina: Easiest to get Def% high\nErica: Helps with CounterAttack generation and also highest CounterAttack dmg buffer\nRachel: The supporty option that increases Shield%, still a great Ego Skill\nRaidel: Trash"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Eishlen | Alsea"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Eishelen: Easier to get dupes then Erica, Increases damage after gaining Counters\nAlsea: Actually can work with Fisting builds, but the lack of dupes make her less good then Wilhelmina"
          }
        }
      ]
