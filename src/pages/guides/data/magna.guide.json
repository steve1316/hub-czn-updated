    {
      "id": "lead-prism",
      "title": {
        "en": "Lead Prism"
      },
      "blocks": [
        {
          "type": "deck",
          "cards": [
            {
              "cardId": "c_1010_srt4",
              "name": "Ice Fragment",
              "cost": 1
