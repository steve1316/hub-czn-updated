        {
          "type": "prose",
          "body": {
            "en": "Season 1 | Forbidden Catalyst"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Ecstasy: 0 Cost 4 hits is great\nGesture: Realistically you can go this if you don't have Narja basically\nBut this is best kept on your supports, not on Haru or you'll lose out on Anchor loops"
          }
        }
