    {
      "id": "skill-persona",
      "title": {
        "en": "Skill Persona"
      },
      "blocks": [
        {
          "type": "prose",
          "body": {
            "en": "Persona 1: Draw is never gonna feel bad, especially if Activated for Free\nPersona 2: For Discard/ Quietus/ Dreamworld synergies or just to be played for free\nPersona 4: For Shield Stack/Counter Team if you really wanted to\nThe Persona cards themselves are good, but on Average Engravings are bad"
          }
        },
