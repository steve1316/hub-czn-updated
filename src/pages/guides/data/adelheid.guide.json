        {
          "type": "prose",
          "body": {
            "en": "Adelheid (ADHD) Blessings and Friends Doggie/Teddy"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Blessing is Adel's main mechanic\nIt's a specific tag that you add to cards for Protect Us to have draw synergies\nOtherwise Blessing Cards will just additionally Fixed Shield 60% on cast\n(Fixed Shield just means no buff/debuff effects like impair or resolve)\nBlessing is considered an Ability, so Rachel, Metallize etc trigger\nAdel's Friends Doggie/Teddy are Unique Created Cards\nYour choice between Damage/Shielding"
          }
        },
        {
          "type": "deck",
          "cards": [
            {
              "cardId": "c_1055_cre1",
              "name": "Doggie",
              "cost": 0,
              "text": {
                "en": "[Haste] [Blessing] 60% Defense-Based Damage."
              }
            },
            {
              "cardId": "c_1055_cre2",
              "name": "Teddy",
              "cost": 0,
              "text": {
                "en": "[Haste] [Blessing] 200% Shield. 2 Damage Reduction."
              }
            }
          ]
        }
      ]
