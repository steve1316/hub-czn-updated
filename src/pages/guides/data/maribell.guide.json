    {
      "id": "notable-refinements",
      "title": {
        "en": "Notable Refinements:"
      },
      "blocks": [
        {
          "type": "prose",
          "body": {
            "en": "On Counterattack, 200% Def Based Damage to all enemies (1 time per turn)"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "When an Attack Card is activated on a target in a Vulnerable state, +15% Critical Chance"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Increase Damage Amount of Attack Cards by 20%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Increase Def Based Damage Amount by +30%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "At the start of battle, if owning 18 or less cards, increase Damage Amount of Attack Cards by 30%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "If Damage is completely blocked, at the start of the next turn, increase Damage Amount of allies by 10% for 1 turn (1 time per turn)"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "Increase Shield Gain Amount by 15%, and increase Heal Amount by 15%"
          }
        },
        {
          "type": "prose",
          "body": {
            "en": "At the start of battle, Draw 1 Exhaust card(s) of this unit"
          }
        }
