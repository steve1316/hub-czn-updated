    {
      "id": "brand-move-guide",
      "title": {
        "en": "Brand Move Guide"
      },
      "blocks": [
        {
          "type": "card-list",
          "items": [
            {
              "cardId": "c_30117_srt4",
              "note": {
                "en": ""
              }
